rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function currentUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function currentUserIsActive() {
      return hasUserProfile() && currentUserData().isActive == true;
    }

    function currentUserIsAdmin() {
      return currentUserIsActive() && currentUserData().role == 'ADMIN';
    }

    function currentUserIsTeacher() {
      return currentUserIsActive() && currentUserData().role == 'TEACHER';
    }

    match /users/{userId} {
      allow read: if currentUserIsAdmin() ||
        currentUserIsTeacher() ||
        (currentUserIsActive() && request.auth.uid == userId);
      allow create, update, delete: if currentUserIsAdmin();
    }

    match /class_groups/{groupId} {
      allow read: if currentUserIsActive();
      allow create, update, delete: if currentUserIsAdmin();
    }

    match /subjects/{subjectId} {
      allow read: if currentUserIsActive();
      allow create, update, delete: if currentUserIsAdmin();
    }

    match /schedules/{scheduleId} {
      allow read: if currentUserIsActive();
      allow create, update, delete: if currentUserIsAdmin();
    }

    match /grades/{gradeId} {
      allow read: if currentUserIsActive();
      allow create: if currentUserIsAdmin() ||
        (currentUserIsTeacher() &&
          request.resource.data.teacherId == currentUserData().id);
      allow update, delete: if currentUserIsAdmin() ||
        (currentUserIsTeacher() &&
          resource.data.teacherId == currentUserData().id);
    }

    match /attendance/{attendanceId} {
      allow read: if currentUserIsActive();
      allow create: if currentUserIsAdmin() ||
        (currentUserIsTeacher() &&
          request.resource.data.markedById == currentUserData().id);
      allow update, delete: if currentUserIsAdmin() ||
        (currentUserIsTeacher() &&
          resource.data.markedById == currentUserData().id);
    }

    match /announcements/{announcementId} {
      allow read: if currentUserIsActive();
      allow create: if currentUserIsAdmin() ||
        (currentUserIsTeacher() &&
          request.resource.data.authorId == currentUserData().id);
      allow update, delete: if currentUserIsAdmin() ||
        (currentUserIsTeacher() &&
          resource.data.authorId == currentUserData().id);
    }

    match /metadata/{docId} {
      allow read, write: if currentUserIsAdmin();
    }
  }
}
